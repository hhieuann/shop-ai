{
  "name": "infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet -c env=dev",
    "diff:staging": "cdk diff -c env=staging",
    "deploy:dev": "cdk deploy --all --require-approval never -c env=dev",
    "deploy:staging": "cdk deploy --all --require-approval never -c env=staging",
    "deploy:prod": "cdk deploy --all --require-approval never -c env=prod"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.274.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1146.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.14",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
