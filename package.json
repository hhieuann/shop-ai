{
  "name": "shop-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Shop linh kiện điện tử serverless trên AWS, gợi ý mua kèm bằng AI",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:smoke": "pnpm -r --if-present run test:smoke",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise services/api/src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css}": "prettier --write"
  }
}
